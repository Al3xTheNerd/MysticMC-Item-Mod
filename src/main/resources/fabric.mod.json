{
  "schemaVersion": 1,
  "id": "mystic-item-browser",
  "version": "${version}",
  "name": "MysticMC Item Browser",
  "license": "0BSD",
  "description": "Browse the list of Custom Items on MysticMC, and preview how they would look when worn!",
  "icon": "assets/mystic-item-browser/icon.png",
  "authors": ["AlexTheNerd"],
  "contact": {
    "homepage": "https://items.mysticmc.co/",
    "sources": "https://github.com/Al3xTheNerd/MysticMC-Item-Mod"
  },
  "environment": "client",
  "entrypoints": {"client": ["co.mysticmc.items.MysticItemBrowser"]},
  "mixins": ["mystic-item-browser.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
